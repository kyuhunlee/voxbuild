# Copy to .env.local. Never commit credentials.
MONGODB_URI=
MONGODB_DB=voxbuild
SESSION_SECRET=
# Server-only key required for Gateway Realtime token minting, locally and on Vercel.
# Ordinary text requests can also authenticate through Vercel OIDC.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_FALLBACK_MODEL=
AI_GATEWAY_REALTIME_MODEL=openai/gpt-realtime-2.1
# Optional legacy direct-OpenAI rollback route; unused by the active Gateway client.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Optional real existing-world catalog HTTPS endpoint; fixture is clearly labeled otherwise.
CATALOG_API_URL=
CATALOG_API_TOKEN=
