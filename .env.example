# Copy to .env.local. Never commit credentials.
MONGODB_URI=
MONGODB_DB=voxbuild
SESSION_SECRET=
# Vercel deployment OIDC authenticates Gateway. Local CLI env pull supplies OIDC.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_FALLBACK_MODEL=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Optional real existing-world catalog HTTPS endpoint; fixture is clearly labeled otherwise.
CATALOG_API_URL=
CATALOG_API_TOKEN=
